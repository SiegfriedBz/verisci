# Variable names only; never commit real values. Copy to .env.local at the
# repo root (gitignored) and fill in; keep env files out of apps/web.
# apps/web/next.config.ts loads the root files for pnpm dev and pnpm build;
# restart pnpm dev after editing them.
# pnpm test needs none of these; pnpm build needs APP_ENV. pnpm dev starts without them,
# but the home page's latest papers, the papers list, and the publish, paper and rating pages
# need the DKG node and publish run settings below, the wallet window REOWN_PROJECT_ID, and
# ratings the chain settings (locally LOCAL_CHAIN_RPC_URL and LOCAL_RATING_CONTRACT).
# Each workspace declares the variables it reads in its own env module (src/env.ts
# in packages, which may import its schema from a file next to it; lib/web-env.ts in
# apps/web; a dev script in scripts/ declares its own); add a variable here in the same
# PR. The Foundry section below is read by forge instead. Programs that run on the DKG
# node server (infra/*) read their settings from an env file there, listed in their
# README (ADR 0004).

# Shared by every workspace (@labstrail/env sharedSchema).
# development | test | production. Next.js, Vitest and the host set it; leave unset locally.
NODE_ENV=
# local | staging | production. local when not deployed (dev machine, CI);
# staging for develop and previews; production for main. Defaults to local, except in a
# production build (pnpm build, every deploy), where it is required.
APP_ENV=local

# DKG node, read by @labstrail/dkg (packages/dkg README), the publish and rating runs, the site's
# pages (publish, paper, rating, papers list and the home page's latest papers) and the
# publish-pdf script.
# The node's base URL: https://verisci-dkg.duckdns.org, the DKG node server (docs/node-host.md).
DKG_URL=
# Bearer token: this environment's credential for the node server, which opens the node and
# GROBID (ADR 0039), so the score-papers script reads it too; locally the `local` one, shown
# on the server with
#   ssh ubuntu@<server> 'sudo sed -n "s/^VERISCI_LOCAL_TOKEN=//p" /etc/caddy/verisci.env'
# (docs/node-host.md → The credentials). Secret.
DKG_TOKEN=
# Full context graph id, <agent address>/<graph name>, spelled as the node lists it: an
# address not in EIP-55 checksum case is refused, since a query in another case reads
# another, empty graph. Only APP_ENV=production may use a -prod graph, and it must.
DKG_CONTEXT_GRAPH=

# Publish run and the site's pages (publish, paper, papers list, rating and the home page's
# latest papers), read by @labstrail/workflows (createWorkflowsEnv, packages/workflows README), with
# the DKG settings above. Each page checks all of them, those it does not use included.
# GROBID's base URL: https://verisci-grobid.duckdns.org, on the node server, which takes
# DKG_TOKEN as its credential; or http://127.0.0.1:8070 for a GROBID run locally in Docker.
GROBID_URL=
# The Pinata account's dedicated gateway, https://<name>.mypinata.cloud, through which the
# publish and rating runs read PDFs. One account is shared by every environment (ADR 0005).
PINATA_GATEWAY_URL=
# A Base Sepolia RPC URL, to check smart-contract wallets' signatures and, on staging and
# production, for the rating functions to read and write the rating contracts and the pages
# to read their ratings. Deployed, the Alchemy RPC URL: Base's public endpoint refused the
# pages' bursts (docs/domain.md → Chain).
CHAIN_RPC_URL=
# Pinata API key (JWT) allowed to upload, list and delete files; the publish-pdf dev script
# reads it too. Secret.
PINATA_JWT=
# A Gemini API key from Google AI Studio: the field check both runs make (ADR 0037) and the
# rating functions' scorer (ADR 0018) read it, and the score-papers dev script too. Every
# deployment checks it at start, previews included. Secret.
GEMINI_API_KEY=
# Inngest's keys, from the Inngest dashboard. Required unless APP_ENV=local, where the
# dev server needs none: leave them empty locally. Secret.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set by Vercel on each deployment (the branch, production's domain, the branch's URL; the last
# two give notifications their links, and apps/web's canonical links, sitemap and structured
# data their address); leave unset locally.
VERCEL_GIT_COMMIT_REF=
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_BRANCH_URL=
# Notifications (ADR 0038), read by @labstrail/workflows: a Telegram bot's token (from
# @BotFather, <bot id>:<secret>) and the numeric id of the chat it posts to. Required on
# production, which refuses to start without them; elsewhere optional: unset, as locally,
# notifications are only logged. One bot and chat serve every environment, and each message
# names its environment: on Vercel, set them on production and on develop only (scoped to that
# branch), so feature previews only log. The token is secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rating functions, read by @labstrail/workflows (createRatingEnv, packages/workflows README)
# with the publish settings above. A deployment serves the rating and oracle functions only
# when ORACLE_PRIVATE_KEY is set: on Vercel, develop (scoped to that branch) and production,
# which refuses to start without it (ADR 0019).
# The oracle's private key, 0x and 64 hex. Locally, the key of Anvil's second default
# account, which anvil prints when it starts (ADR 0036). Secret.
ORACLE_PRIVATE_KEY=
# The DKG node's publisher wallets, comma-separated (docs/node-host.md lists them), whose ETH
# and TRAC on Base Sepolia the hourly health check watches (ADR 0038). Required outside local, so
# a deployment that would watch none refuses to start; optional locally.
PUBLISHER_ADDRESSES=
# Local only (APP_ENV=local): Anvil's URL, http://127.0.0.1:8546 (8545, Anvil's default, is
# the port of the DKG node's RPC proxy), and the RatingController deployed there (the address
# forge script prints). Read by the rating functions, the site's rating pages (apps/web,
# which also offers Anvil to the wallet), the webhook's intake (the contract) and the
# rate-paper, fund-local and post-webhook (the URL) dev scripts.
LOCAL_CHAIN_RPC_URL=
LOCAL_RATING_CONTRACT=
# The Alchemy Notify webhook's signing key (ADR 0017), from the environment's webhook page in
# the Alchemy Notify dashboard, read by @labstrail/workflows for apps/web's /api/webhooks/alchemy and
# checked at start with the workflows' settings. Without it the route answers 404, as on feature
# previews. Locally, any value lets the post-webhook dev script check the route against the Anvil
# contract. Secret.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Upload page, read by apps/web (createWebEnv, apps/web README). Required unless
# APP_ENV=local: locally, without Upstash, the upload limits count in memory.
# Upstash Redis REST address and token (the database's REST API panel): one database for
# every environment, each counter named after APP_ENV (ADR 0005). The token is secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Reown project id (cloud.reown.com), for the wallet window, from one project shared by
# every environment. Read on the server and handed to the page.
REOWN_PROJECT_ID=

# Foundry: read by forge when you deploy RatingController from your machine, through
# a link from packages/contracts/.env to the root .env.local (packages/contracts README,
# Deployment).
# Local only. The deployer key stays in a Foundry keystore (--account).
# Base Sepolia RPC URL (an Alchemy RPC URL works).
BASE_SEPOLIA_RPC_URL=
# Etherscan API v2 key, which also verifies on Basescan.
ETHERSCAN_API_KEY=

# 1 or true turns validation off and returns every variable unchecked, with no
# defaults. Nothing needs it today; never for next build or a running app.
SKIP_ENV_VALIDATION=
