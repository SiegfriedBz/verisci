# Variable names only; never commit real values. Copy to .env.local at the
# repo root (gitignored) and fill in; keep env files out of apps/web.
# apps/web/next.config.ts loads the root files for pnpm dev and pnpm build;
# restart pnpm dev after editing them.
# pnpm dev and pnpm test need none of these; pnpm build needs APP_ENV.
# Each workspace declares the variables it reads in its own src/env.ts (a dev
# script in scripts/ declares its own); add a variable here in the same PR. The
# Foundry section below is read by forge instead. Programs that run on the DKG node server
# (infra/*) read their settings from an env file there, listed in their README
# (ADR 0004).

# Shared by every workspace (@verisci/env sharedSchema).
# development | test | production. Next.js, Vitest and the host set it; leave unset locally.
NODE_ENV=
# local | staging | production. local when not deployed (dev machine, CI);
# staging for develop and previews; production for main. Defaults to local, except in a
# production build (pnpm build, every deploy), where it is required.
APP_ENV=local

# DKG node, read by @verisci/dkg (packages/dkg README), the publish run and the publish-pdf script.
# The node's base URL: http://127.0.0.1:9200 while it runs on a developer's computer.
DKG_URL=
# Bearer token: the node's admin token (~/.dkg/auth.token) locally; the environment's
# credential once the node is on its server. Secret.
DKG_TOKEN=
# Full context graph id, <agent address>/<graph name>. Only APP_ENV=production may use
# a -prod graph, and it must.
DKG_CONTEXT_GRAPH=

# Publish run and upload page, read by @verisci/agents (createAgentsEnv, packages/agents
# README), with the DKG settings above.
# GROBID's base URL: http://127.0.0.1:8070 while it runs on a developer's computer.
GROBID_URL=
# The Pinata account's dedicated gateway, https://<name>.mypinata.cloud.
PINATA_GATEWAY_URL=
# A Base Sepolia RPC URL, to check smart-contract wallets' signatures (an Alchemy URL works).
CHAIN_RPC_URL=
# Pinata API key (JWT) allowed to upload, list and delete files; the publish-pdf dev script
# reads it too. Secret.
PINATA_JWT=
# Inngest's keys, from the Inngest dashboard. Required unless APP_ENV=local, where the
# dev server needs none: leave them empty locally. Secret.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set by Vercel on each deployment (the branch); leave unset locally.
VERCEL_GIT_COMMIT_REF=

# Foundry: read by forge when you deploy RatingController from your machine, through
# a link from packages/contracts/.env to the root .env.local (packages/contracts README,
# Deployment).
# Local only. The deployer key stays in a Foundry keystore (--account).
# Base Sepolia RPC URL (an Alchemy URL works).
BASE_SEPOLIA_RPC_URL=
# Etherscan API v2 key, which also verifies on Basescan.
ETHERSCAN_API_KEY=

# 1 or true turns validation off and returns every variable unchecked, with no
# defaults. Nothing needs it today; never for next build or a running app.
SKIP_ENV_VALIDATION=
