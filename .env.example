# Variable names only; never commit real values. pnpm dev and pnpm test need
# none of these, and a local build runs as APP_ENV=local pnpm build. Real
# values will go in a root .env.local (gitignored); nothing loads the root
# file until the web plan adds a loader. Next.js already loads apps/web/.env*
# on its own, so do not leave stray env files there.
# Each workspace declares the variables it reads in its own src/env.ts;
# add a variable here in the same PR that adds it there.

# Shared by every workspace (@verisci/env sharedSchema).
# development | test | production. Next.js, Vitest and the host set it; leave unset locally.
NODE_ENV=
# local | staging | production. local when not deployed (dev machine, CI);
# staging for develop; production for main. Defaults to local, except in a
# production build (pnpm build, every deploy), where it is required.
APP_ENV=local

# 1 or true turns validation off and returns every variable unchecked, with no
# defaults. Nothing needs it today; never for next build or a running app.
SKIP_ENV_VALIDATION=
