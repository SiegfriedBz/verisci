{
  "name": "@verisci/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "forge fmt --check && forge lint --deny notes && solhint --disc --noPoster 'src/**/*.sol' 'script/**/*.sol'",
    "test": "vitest run && forge test",
    "generate:abi": "forge build && node tools/generate-abi.ts",
    "record-deployment": "node tools/record-deployment.ts"
  },
  "dependencies": {
    "@verisci/core": "workspace:*",
    "@verisci/env": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "solhint": "6.2.4"
  }
}
