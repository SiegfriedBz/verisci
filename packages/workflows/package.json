{
  "name": "@labstrail/workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publish-pdf": "node --env-file-if-exists=../../.env.local scripts/publish-pdf.ts",
    "rate-paper": "node --env-file-if-exists=../../.env.local scripts/rate-paper.ts",
    "score-papers": "node --env-file-if-exists=../../.env.local scripts/score-papers.ts",
    "fund-local": "node --env-file-if-exists=../../.env.local scripts/fund-local.ts",
    "post-webhook": "node --env-file-if-exists=../../.env.local scripts/post-webhook.ts"
  },
  "dependencies": {
    "@labstrail/contracts": "workspace:*",
    "@labstrail/core": "workspace:*",
    "@labstrail/dkg": "workspace:*",
    "@labstrail/env": "workspace:*",
    "inngest": "4.22.0",
    "unpdf": "1.8.1",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
